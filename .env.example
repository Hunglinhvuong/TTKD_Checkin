# --- Database ---
DATABASE_URL=postgresql://attendance:change_me@localhost:5432/attendance
TEST_DATABASE_URL=postgresql://attendance:change_me@localhost:5432/attendance_test
DB_POOL_MIN=1
DB_POOL_MAX=10

# --- Telegram (Giai đoạn 2) ---
BOT_TOKEN=
# Danh sách Telegram User ID admin, phân tách bằng dấu phẩy
ADMIN_TELEGRAM_IDS=

# Chỉ nhận ảnh điểm danh từ các chat này (ID group, thường âm: -100...). Để trống = nhận ở mọi chat
ATTENDANCE_CHAT_IDS=
# Thư mục lưu ảnh tạm trước khi xác minh xong
UPLOAD_TMP_DIR=tmp/photos

# --- OCR.Space (worker xác định thời gian và tọa độ từ ảnh) ---
OCR_SPACE_API_KEY=
OCR_SPACE_TIMEOUT_S=60
OCR_SPACE_MIN_INTERVAL_S=5
# Gói miễn phí giới hạn ảnh 1 MB; tăng giá trị nếu gói OCR.Space của bạn cho phép file lớn hơn.
OCR_SPACE_MAX_FILE_BYTES=1000000

# --- Lưu ảnh điểm danh ---
# cloudinary (mặc định) hoặc local; local không cần thông tin xác thực Cloudinary
PHOTO_STORAGE_BACKEND=cloudinary
LOCAL_PHOTO_DIR=local/photos
# 90 ngày tương đương khoảng 3 tháng; ảnh cũ hơn sẽ được worker tự động xóa
LOCAL_PHOTO_RETENTION_DAYS=90

# --- Cloudinary (dùng khi PHOTO_STORAGE_BACKEND=cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Thư mục lưu ảnh trên Cloudinary (chữ/số/_/-, phân cấp bằng /). Ảnh lưu tại <thư mục>/<ngày>/<user>_<buổi>_<id>
CLOUDINARY_FOLDER=attendance
# true: đặt thêm asset_folder để ảnh hiện trong thư mục ở Media Library (tài khoản "dynamic folder mode", mặc định của
# tài khoản mới). Nếu upload báo lỗi liên quan asset_folder (tài khoản "fixed folder mode") thì đặt false.
CLOUDINARY_SET_ASSET_FOLDER=true

# --- Chung ---
TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Dashboard (Giai đoạn 6) ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501
# Xem dữ liệu: không cần đăng nhập. Tài khoản/mật khẩu sửa dashboard cấu hình riêng trong Streamlit Secrets;
# không dùng BOT_TOKEN. Mỗi tài khoản dashboard gắn với Telegram ID admin đang hoạt động trong bảng admins.

# --- Vận hành (Giai đoạn 7) ---
# Ghi log ra file logs/app.log (chạy tay). Dịch vụ systemd tự đặt false và ghi vào journald.
LOG_TO_FILE=true
# Thư mục và số ngày giữ bản sao lưu PostgreSQL (deploy/backup.sh)
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=14
